/dts-v1/;

#include "rk3568-roc-k40pro.dts"

/ {
	compatible = "easepi,r1", "rockchip,rk3568";
	model = "EasePi R1";
	hwmodel_id = "R1";

	chosen {
		default-firewall = "dual";
		power-key-factory-reset;
		power-key-dbclick;
	};
};

&rkvdec {
	/delete-property/ rockchip,disable-auto-freq;
	operating-points-v2 = <&rkvdec_opp_table>;
};

&rkvenc {
	rockchip,advanced-rates = <400000000>, <0>, <400000000>;
	rockchip,default-max-load = <2088960>;
	operating-points-v2 = <&rkvenc_opp_table>;
};
